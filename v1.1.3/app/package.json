{
  "name": "nawu-app",
  "private": true,
  "version": "1.1.3",
  "description": "纳物 NaWu · 物品与消费复盘 Android App（Capacitor + React + Vite）",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "check-env": "node scripts/check-env.mjs",
    "cap:add": "npx cap add android",
    "cap:sync": "npm run build && npx cap sync android",
    "build:android": "node scripts/check-env.mjs && npm run build && npx cap sync android",
    "build:apk": "scripts\\build-android.bat"
  },
  "dependencies": {
    "@capacitor-community/media": "^8.0.0",
    "@capacitor/app": "7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "7.6.9",
    "@capacitor/device": "7.0.5",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/haptics": "7.0.5",
    "@capacitor/keyboard": "7.0.6",
    "@capacitor/network": "7.0.4",
    "@capacitor/preferences": "7.0.4",
    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "7.0.6",
    "dayjs": "1.11.23",
    "lucide-react": "^1.52.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "simple-icons": "^16.35.0",
    "tesseract.js": "^5.1.1",
    "zustand": "5.0.15"
  },
  "optionalDependencies": {
    "@esbuild/win32-x64": "0.21.5",
    "@rollup/rollup-win32-x64-msvc": "^4.64.0"
  },
  "devDependencies": {
    "@capacitor/android": "7.6.9",
    "@capacitor/cli": "7.6.9",
    "@types/node": "^22.13.1",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "^10.4.20",
    "jsdom": "^30.1.2",
    "postcss": "^8.4.47",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
